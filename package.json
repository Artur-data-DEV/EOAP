{
  "name": "eoap",
  "version": "0.2.0",
  "description": "EOAP - Enterprise Operations Automation Platform | Official ServiceNow Scoped App Template with full Agentic Orchestration (Flows, Decision Tables, Virtual Agent, KB, VTB, multi-agent system)",
  "private": true,
  "scripts": {
    "build": "now-sdk build",
    "deploy": "now-sdk install",
    "deploy:reinstall": "now-sdk install --reinstall",
    "auth": "now-sdk auth",
    "auth:list": "now-sdk auth --list",
    "clean": "now-sdk clean",
    "agent:orchestrate": "npx ts-node agents/orchestrator.ts",
    "vtb:setup": "npx ts-node agents/vtb-setup.ts",
    "template:validate": "echo 'Structure validation - see .github/workflows'"
  },
  "devDependencies": {
    "@servicenow/sdk": "^4.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "servicenow",
    "fluent-sdk",
    "eoap",
    "access-governance",
    "offboarding",
    "audit-trail",
    "template",
    "agentic",
    "multi-agent",
    "virtual-agent",
    "decision-table",
    "vtb"
  ],
  "license": "UNLICENSED"
}
